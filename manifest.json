{
  "manifest_version": 3,
  "name": "VANTA Agent",
  "version": "2.1",
  "description": "Нейро-строитель для brofist.io editor (OpenRouter)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://brofist.io/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://brofist.io/editor/*"],
    "js": ["inject.js"],
    "run_at": "document_idle"
  }]
}